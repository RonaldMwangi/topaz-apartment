---
import { getCollection } from 'astro:content';
import { site } from '../../config/site';
import { normalizeWhatsAppNumber } from '../../utils/whatsapp';
import { rateLabel } from '../../config/pricing';
interface Props {
  mode?: 'stay' | 'transfer';
  apartmentId?: string;
  id?: string;
}
const { mode = 'stay', apartmentId, id = 'enquiry' } = Astro.props;
const apartments = (await getCollection('accommodation', ({ data }) => !data.draft)).sort((a, b) =>
  a.data.number.localeCompare(b.data.number),
);
const connected = !!normalizeWhatsAppNumber(site.whatsappNumber);
const prefix = `${id}-`;
---

<div class="enquiry-form-shell" id={id}>
  <div class="form-top">
    <span class="eyebrow">{mode === 'transfer' ? 'Journey details' : 'Your stay, your way'}</span>
    <span class="form-status">
      <span aria-hidden="true"></span>
      {connected ? 'Direct to WhatsApp' : 'Enquiry preview · WhatsApp pending'}
    </span>
  </div>
  <h3>{mode === 'transfer' ? 'Where can we take you?' : 'Tell us what you have in mind.'}</h3>
  <p class="form-intro">{mode === 'transfer'
    ? 'Share a few details so the property can discuss arrangements, availability and costs. All fields are optional.'
    : 'A few details help start the conversation. All fields are optional; the property confirms availability and rates directly.'}</p>
  <form
    data-enquiry-form
    data-phone={site.whatsappNumber ?? ''}
    data-property={site.name}
    data-mode={mode}
  >
    {mode === 'stay' ? (
      <>
        <div class="form-grid">
          <div class="field full">
            <label for={`${prefix}apartment`}>Preferred accommodation</label>
            <select id={`${prefix}apartment`} name="apartment">
              <option value="">I’d like some guidance</option>
              {apartments.map(({ data }) => (
                <option value={data.id} selected={data.id === apartmentId} data-title={data.title} data-rate={rateLabel(data.id)}>
                  {`${data.title} — ${rateLabel(data.id) ?? 'Enquire for rates'} / night`}
                </option>
              ))}
            </select>
          </div>
          <div class="field">
            <label for={`${prefix}check-in`}>Intended check-in</label>
            <input id={`${prefix}check-in`} type="date" name="checkIn" />
          </div>
          <div class="field">
            <label for={`${prefix}check-out`}>Intended check-out</label>
            <input id={`${prefix}check-out`} type="date" name="checkOut" />
          </div>
          <div class="field full">
            <label for={`${prefix}guests`}>Number of guests</label>
            <input
              id={`${prefix}guests`}
              type="number"
              name="guests"
              min="1"
              step="1"
              inputmode="numeric"
              placeholder="How many of you?"
            />
          </div>
        </div>
        <fieldset class="arrangements">
          <legend>Anything else to arrange?</legend>
          <label class="checkbox">
            <input type="checkbox" name="meals" />
            <span>Advance meal / kitchen arrangements</span>
          </label>
          <label class="checkbox">
            <input type="checkbox" name="transfer" />
            <span>Transport or transfer arrangements</span>
          </label>
        </fieldset>
      </>
    ) : (
      <div class="form-grid">
        <div class="field">
          <label for={`${prefix}pickup`}>Pickup location</label>
          <input
            id={`${prefix}pickup`}
            type="text"
            name="pickup"
            maxlength="180"
            placeholder="Where from?"
          />
        </div>
        <div class="field">
          <label for={`${prefix}destination`}>Destination</label>
          <input
            id={`${prefix}destination`}
            type="text"
            name="destination"
            maxlength="180"
            placeholder="Where to?"
          />
        </div>
        <div class="field">
          <label for={`${prefix}date`}>Preferred date</label>
          <input id={`${prefix}date`} type="date" name="transferDate" />
        </div>
        <div class="field">
          <label for={`${prefix}time`}>
            Preferred time <span class="label-note">(Kenya time)</span>
          </label>
          <input id={`${prefix}time`} type="time" name="transferTime" />
        </div>
        <div class="field full">
          <label for={`${prefix}passengers`}>Number of passengers</label>
          <input
            id={`${prefix}passengers`}
            type="number"
            name="passengers"
            min="1"
            step="1"
            inputmode="numeric"
            placeholder="How many passengers?"
          />
        </div>
      </div>
    )}
    <p class="form-error" role="alert" data-form-error hidden></p>
    <div class="form-submit">
      <button class="button button-primary" type="submit" data-submit disabled>
        {connected ? 'Send enquiry to WhatsApp' : 'Preview your enquiry'}
        <span aria-hidden="true">↗</span>
      </button>
      <span class="small muted">{connected
        ? 'Continue the conversation in WhatsApp.'
        : 'The public WhatsApp number is not yet configured.'}</span>
    </div>
    <p class="privacy-note">
      An enquiry does not create a reservation. This website does not store your enquiry details.
      {connected
        ? 'Submitting opens WhatsApp with your message for you to review and send.'
        : 'In this development state, submitting only shows your message here.'}
    </p>
    <div class="message-preview" data-message-preview hidden tabindex="-1">
      <h4>Your enquiry preview</h4>
      <p class="small">WhatsApp is not connected yet. This message has not been sent.</p>
      <pre data-message-text></pre>
    </div>
    <noscript>
      <p>
        JavaScript is needed to prepare this optional message.
        <a href="/contact/">See contact information</a>
        or use an available direct WhatsApp link.
      </p>
    </noscript>
  </form>
</div>

<script>
  import { trackEnquiry } from '../../utils/analytics';
  import {
    buildEnquiryMessage,
    createWhatsAppEnquiryLink,
    normalizeWhatsAppNumber,
    validateEnquiry,
    type EnquiryDetails,
  } from '../../utils/whatsapp';

  document.querySelectorAll<HTMLFormElement>('[data-enquiry-form]').forEach((form) => {
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]');
    const error = form.querySelector<HTMLParagraphElement>('[data-form-error]');
    const preview = form.querySelector<HTMLDivElement>('[data-message-preview]');
    const messageText = form.querySelector<HTMLElement>('[data-message-text]');
    if (!submit || !error || !preview || !messageText) return;
    submit.disabled = false;
    // Disabled until this handler is attached: no accidental GET submission or URL leakage without JS.
    const date = new Date();
    const today = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
    form.querySelectorAll<HTMLInputElement>('input[type="date"]').forEach((input) => {
      input.min = today;
    });
    const apartmentSelect = form.querySelector<HTMLSelectElement>('[name="apartment"]');
    if (apartmentSelect) {
      const params = new URLSearchParams(window.location.search);
      const requested = params.get('apartment');
      if (requested && [...apartmentSelect.options].some((option) => option.value === requested))
        apartmentSelect.value = requested;
      const interest = params.get('interest');
      const checkbox = form.querySelector<HTMLInputElement>(
        interest === 'meals'
          ? '[name="meals"]'
          : interest === 'transfer'
            ? '[name="transfer"]'
            : '[data-no-interest]',
      );
      if (checkbox) checkbox.checked = true;
    }
    const checkIn = form.querySelector<HTMLInputElement>('[name="checkIn"]');
    const checkOut = form.querySelector<HTMLInputElement>('[name="checkOut"]');
    checkIn?.addEventListener('input', () => {
      if (!checkOut) return;
      if (checkIn.value) {
        const next = new Date(`${checkIn.value}T00:00:00Z`);
        next.setUTCDate(next.getUTCDate() + 1);
        checkOut.min = next.toISOString().slice(0, 10);
      } else checkOut.min = today;
    });
    form.addEventListener('input', () => {
      preview.hidden = true;
      error.hidden = true;
    });
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const values = new FormData(form);
      const get = (key: string) => String(values.get(key) ?? '').trim();
      const details: EnquiryDetails = {
        kind:
          form.dataset.mode === 'transfer'
            ? 'transfer'
            : get('meals') && !get('apartment') && !get('checkIn') && !get('checkOut')
              ? 'meals'
              : 'stay',
        apartment: apartmentSelect?.value
          ? apartmentSelect.selectedOptions[0]?.dataset.title
          : undefined,
        nightlyRate: apartmentSelect?.selectedOptions[0]?.dataset.rate,
        checkIn: get('checkIn'),
        checkOut: get('checkOut'),
        guests: get('guests'),
        meals: values.has('meals'),
        transfer: values.has('transfer'),
        pickup: get('pickup'),
        destination: get('destination'),
        transferDate: get('transferDate'),
        transferTime: get('transferTime'),
        passengers: get('passengers'),
      };
      const validation = validateEnquiry(details, today);
      if (validation) {
        error.textContent = validation;
        error.hidden = false;
        return;
      }
      error.hidden = true;
      const propertyName = form.dataset.property ?? '';
      const phoneNumber = normalizeWhatsAppNumber(form.dataset.phone);
      const href = createWhatsAppEnquiryLink({ phoneNumber, propertyName, details });
      if (href) {
        trackEnquiry({ enquiry_type: details.kind ?? 'stay', accommodation_type: apartmentSelect?.value === 'one-bedroom' || apartmentSelect?.value === 'two-bedroom' ? apartmentSelect.value : undefined, cta_location: form.dataset.mode === 'transfer' ? 'transfer_form' : 'stay_form' });
        window.location.assign(href);
        return;
      }
      messageText.textContent = buildEnquiryMessage(propertyName, details);
      preview.hidden = false;
      preview.focus();
    });
  });
</script>

<style>
  .enquiry-form-shell {
    background: var(--color-surface);
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-soft);
    scroll-margin-top: 2rem;
  }
  .form-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    align-items: start;
  }
  .form-status {
    font-size: var(--text-xs);
    color: var(--color-muted);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .form-status > span {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-brand-red);
  }
  h3 {
    font-size: var(--text-h3);
    margin-bottom: 1rem;
  }
  .form-intro {
    color: var(--color-muted);
    font-size: var(--text-base);
    max-width: 35rem;
  }
  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .field {
    min-width: 0;
  }
  .full {
    grid-column: 1 / -1;
  }
  .field label {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    margin-bottom: 0.5rem;
  }
  .label-note {
    color: var(--color-muted);
  }
  .field input,
  select {
    width: 100%;
    min-width: 0;
    min-height: 3.25rem;
    padding: 0.75rem;
    border: 1px solid var(--color-control-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-base);
  }
  input::placeholder {
    color: var(--color-muted);
    opacity: 1;
  }
  .arrangements {
    margin-top: 1.5rem;
  }
  legend {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    margin-bottom: 0.5rem;
  }
  .checkbox {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .checkbox input {
    width: 1.125rem;
    height: 1.125rem;
    accent-color: var(--color-action);
    flex-shrink: 0;
  }
  .form-submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 1.75rem;
  }
  .form-submit > span {
    max-width: 16rem;
    font-size: var(--text-xs);
  }
  .privacy-note {
    font-size: var(--text-xs);
    color: var(--color-muted);
    margin-top: 1rem;
  }
  .form-error {
    color: var(--color-error);
    margin-top: 1rem;
  }
  .message-preview {
    border: 1px solid var(--color-border);
    padding: 1.5rem;
    margin-top: 1.5rem;
    background: var(--color-background);
  }
  .message-preview h4 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }
  pre {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font: inherit;
    font-size: var(--text-sm);
  }
  @media (max-width: 40rem) {
    .form-grid {
      grid-template-columns: 1fr;
    }
    .form-submit .button {
      width: 100%;
    }
  }
</style>
