---
import { facilities } from '../../config/facilities';
import WhatsAppEnquiry from '../enquiries/WhatsAppEnquiry.astro';
interface Props {
  detailed?: boolean;
}
const { detailed = false } = Astro.props;
---

<div class:list={['facilities-grid', { detailed }]}>{facilities.map((facility) => (
  <article class="facility" id={detailed ? facility.id : undefined}>
    <div class="facility-top">
      <span class="eyebrow">{facility.number} / {facility.id === 'pool' ? 'Property facility' : 'By advance arrangement'}</span>
      <span class="facility-mark" aria-hidden="true">
        {facility.id === 'pool'
          ? '≈'
          : facility.id === 'meals'
              ? '◌'
              : '↗'}
      </span>
    </div>
    <h3>{facility.title}</h3>
    <p>{facility.description}</p>
    {detailed && <p class="facility-note">{facility.note}</p>}
    {detailed && facility.enquiryKind !== 'general' ? (
      <WhatsAppEnquiry kind={facility.enquiryKind} label={facility.enquiryKind === 'meals' ? 'Plan Your Meals' : facility.enquiryKind === 'yacht' ? 'Arrange Your Yacht Experience' : 'Plan Your Transfer'} variant="text" ctaLocation="facility_details" />
    ) : <a
      class="text-link"
      href={
        facility.id === 'transfers' && detailed
          ? '#transfer-enquiry'
          : facility.id === 'meals' && detailed
            ? '/contact/?interest=meals#enquiry'
            : `/facilities/#${facility.id === 'yacht' ? 'coastal-experiences' : facility.id}`
      }
    >
      {facility.id === 'meals' && detailed
        ? 'Enquire about meals'
        : facility.id === 'transfers' && detailed
          ? 'Arrange your transfer'
          : 'Discover more'}
      <span aria-hidden="true">↗</span>
    </a>}
  </article>
))}</div>
<style>
  .facilities-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
  }
  .facility {
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: start;
    min-width: 0;
    scroll-margin-top: 2rem;
  }
  .facility-top {
    display: flex;
    width: 100%;
    justify-content: space-between;
    align-items: start;
  }
  .facility-top .eyebrow {
    font-size: var(--text-xs);
  }
  .facility-mark {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    line-height: 1;
    color: var(--color-brand-red);
  }
  h3 {
    font-size: var(--text-h3);
    letter-spacing: var(--tracking-heading);
    margin-block: 0.75rem 1rem;
  }
  p {
    color: var(--color-muted);
    font-size: var(--text-base);
  }
  .facility-note {
    font-size: var(--text-xs);
  }
  .text-link {
    margin-top: auto;
  }
  .detailed {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4rem;
  }
  .detailed h3 {
    font-size: var(--text-h3);
  }
  .detailed p {
    max-width: 30rem;
  }
  @media (max-width: 64rem) {
    .facilities-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 40rem) {
    .facilities-grid,
    .detailed {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
