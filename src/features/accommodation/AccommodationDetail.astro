---
import { getCollection, type CollectionEntry } from 'astro:content';
import Media from '../../components/Media.astro';
import { photoForPlacement } from '../../config/media';
import Rate from './Rate.astro';
import WhatsAppEnquiry from '../enquiries/WhatsAppEnquiry.astro';
import EnquirySection from '../enquiries/EnquirySection.astro';
import Gallery from '../gallery/Gallery.astro';
interface Props {
  apartment: CollectionEntry<'accommodation'>;
}
const {
  apartment: { data },
} = Astro.props;
const alternative = (
  await getCollection('accommodation', ({ data: other }) => !other.draft && other.id !== data.id)
)[0];
const photo = photoForPlacement(`detail-featured:${data.id}`);
---

<div class="container">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">/</span>
    <a href="/accommodation/">Accommodation</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{data.shortName}</span>
  </nav>
  <section class="detail-hero grid-12" aria-labelledby="apartment-title">
    <div class="detail-heading">
      <span class="eyebrow">
        {data.number}
        / The apartments · Shanzu, Mombasa
      </span>
      <h1 id="apartment-title">{data.title}</h1>
      <p class="lead">{data.introduction}</p>
    </div>
    <div class="hero-aside">
      <p>{data.description}</p>
      <Rate apartmentId={data.id} compact />
      <a class="text-link" href="#apartment-rates">
        Rates & enquiry details
        <span aria-hidden="true">↓</span>
      </a>
    </div>
    <div class="detail-media">
      <Media
        photo={photo}
        label={data.title}
        variant={data.id === 'one-bedroom' ? 'light' : 'soft'}
        aspect="landscape"
        sizes="(max-width: 1422px) 90vw, 1280px"
        priority
      />
    </div>
  </section>
  <section class="detail-body grid-12 section" aria-label="Apartment information">
    <div class="detail-copy">
      <span class="eyebrow">Make it your stay</span>
      <h2>
        Your time in Shanzu,
        <br />
        your way
      </h2>
      {data.detailedDescription && <p class="lead">{data.detailedDescription}</p>}
      <p>
        Tell us about your plans and ask the property to confirm the apartment details for your
        visit. Guest capacity and sleeping arrangements will be confirmed directly.
      </p>
      {(data.guestCapacity || data.bedConfiguration) && (
        <dl>
          {data.guestCapacity && (
            <div>
              <dt>Guest capacity</dt>
              <dd>Up to {data.guestCapacity} guests</dd>
            </div>
          )}
          {data.bedConfiguration && (
            <div>
              <dt>Bed configuration</dt>
              <dd>{data.bedConfiguration}</dd>
            </div>
          )}
        </dl>
      )}
      {data.amenities.length > 0 && (
        <section class="detail-subsection">
          <h3>Included amenities</h3>
          <ul>
            {data.amenities.map((amenity) => (
              <li>{amenity}</li>
            ))}
          </ul>
        </section>
      )}
      {data.policies.length > 0 && (
        <section class="detail-subsection">
          <h3>Accommodation policies</h3>
          <ul>
            {data.policies.map((policy) => (
              <li>{policy}</li>
            ))}
          </ul>
        </section>
      )}
      <div class="arrangements-note">
        <span class="eyebrow">A little forward planning</span>
        <h3>More than the apartment</h3>
        <p>
          Explore the property’s facilities and enquire about advance meal arrangements or transport
          for your stay.
        </p>
        <a class="text-link" href="/facilities/">
          Facilities & arrangements
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <aside class="rate-panel" id="apartment-rates" aria-label={`${data.title} rates and enquiries`}>
      <span class="eyebrow">Plan your stay</span>
      <Rate apartmentId={data.id} />
      <hr class="rule" />
      <WhatsAppEnquiry
        kind="stay"
        enquiryIdentifier={data.enquiryIdentifier}
        apartmentId={data.id}
        label="Enquire about this apartment"
        fallbackLabel="Prepare an apartment enquiry"
        ctaLocation="apartment_detail"
      />
      <p class="small muted">
        Share your preferred dates. Rates, availability and reservation terms are confirmed directly
        by the property.
      </p>
    </aside>
  </section>
  <section class="section-bottom" aria-label="Apartment gallery">
    <Gallery category={data.id} />
  </section>
  {alternative && (
    <section class="alternative">
      <div>
        <span class="eyebrow">Another way to stay</span>
        <h2>{alternative.data.title}</h2>
      </div>
      <a class="button button-outline" href={`/accommodation/${alternative.data.id}/`}>
        Explore {alternative.data.shortName.toLowerCase()}
        <span aria-hidden="true">↗</span>
      </a>
    </section>
  )}
</div>
<EnquirySection />
<style>
  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    padding-top: 2rem;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
  .breadcrumbs a {
    padding-block: 0.5rem;
  }
  .detail-hero {
    padding-top: clamp(2rem, 4vw, 4rem);
  }
  .detail-heading {
    grid-column: span 8;
  }
  h1 {
    font-size: var(--text-h1);
    max-width: 17ch;
  }
  .detail-heading .lead {
    margin-top: 1.5rem;
  }
  .hero-aside {
    grid-column: span 4;
    align-self: end;
    font-size: var(--text-base);
    color: var(--color-muted);
    padding-bottom: 1.5rem;
  }
  .hero-aside > :global(.rate) {
    margin-bottom: 1rem;
    color: var(--color-text);
  }
  .detail-media {
    grid-column: 1 / -1;
  }
  .detail-media :global(.media-visual) {
    aspect-ratio: 16 / 9;
  }
  .detail-copy {
    grid-column: span 7;
  }
  .detail-copy > h2 {
    margin-bottom: 2rem;
  }
  .detail-copy > p {
    max-width: 34rem;
    color: var(--color-muted);
  }
  .rate-panel {
    grid-column: 9 / -1;
    background: var(--color-surface);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-soft);
    align-self: start;
  }
  .rate-panel > :global(* + *) {
    margin-top: 1.5rem;
  }
  .arrangements-note {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .arrangements-note h3 {
    margin-bottom: 1rem;
  }
  .arrangements-note p {
    color: var(--color-muted);
    font-size: var(--text-base);
    max-width: 32rem;
  }
  dl > div {
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-border);
  }
  dt {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }
  dd {
    margin: 0.5rem 0 0;
  }
  .detail-subsection {
    margin-top: 2rem;
  }
  .alternative {
    padding-block: 3rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }
  .alternative h2 {
    font-size: var(--text-h3);
  }
  .alternative .eyebrow {
    margin-bottom: 0.75rem;
  }
  @media (max-width: 64rem) {
    .detail-copy {
      grid-column: span 6;
    }
    .rate-panel {
      grid-column: 7 / -1;
    }
  }
  @media (max-width: 48rem) {
    .detail-media :global(.media-visual) {
      aspect-ratio: 4 / 5;
    }
    .detail-heading,
    .hero-aside,
    .detail-copy,
    .rate-panel {
      grid-column: 1 / -1;
    }
    .hero-aside {
      padding-bottom: 0;
    }
    .rate-panel {
      margin-top: 1.5rem;
    }
  }
</style>
