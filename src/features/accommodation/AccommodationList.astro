---
import { getCollection } from 'astro:content';
import AccommodationCard from './AccommodationCard.astro';
const apartments = (await getCollection('accommodation', ({ data }) => !data.draft)).sort((a, b) =>
  a.data.number.localeCompare(b.data.number),
);
---

<div class="accommodation-list">{apartments.map((apartment) => <AccommodationCard apartment={apartment} />)}</div>
<style>
  .accommodation-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4rem);
  }
  @media (max-width: 48rem) {
    .accommodation-list {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }
  }
</style>
