---
import { Picture } from 'astro:assets';
import { heroPhoto } from '../../config/media';
import { site } from '../../config/site';
import { pricing, formatNightlyRate } from '../../config/pricing';
import WhatsAppEnquiry from '../enquiries/WhatsAppEnquiry.astro';

const features = [
  {
    number: '01', title: 'One-Bedroom Apartment',
    rate: formatNightlyRate(pricing['one-bedroom']),
    description: 'Your own Shanzu base for a welcoming coastal getaway.',
    href: '/accommodation/one-bedroom/', action: 'View Apartment',
    icon: 'M4 20V6m0 10h24v10m-24-6h24M8 16v-5h7v5m2 0v-5h7v5M4 26v-6',
  },
  {
    number: '02', title: 'Two-Bedroom Apartment',
    rate: formatNightlyRate(pricing['two-bedroom']),
    description: 'Two bedrooms for your stay in Shanzu, Mombasa.',
    href: '/accommodation/two-bedroom/', action: 'View Apartment',
    icon: 'M5 27V5h22v22H5Zm11-22v22M5 16h22M10 10h1m10 0h1M10 21h1m10 0h1',
  },
  {
    number: '03', title: 'Beyond Your Stay', rate: null,
    description: 'Unwind by the pool, plan your meals, and let us organise transfers and yacht experiences.',
    href: '/facilities/', action: 'Explore Experiences',
    icon: 'M5 27V11l11-6 11 6v16M11 27v-9h10v9M11 12h1m8 0h1M4 27h24',
  },
];
if (!heroPhoto) throw new Error('The homepage hero needs an approved photograph.');
const sourceWidth = heroPhoto.src.width;
const widths = [480, 768, 1200, 1600, 2000].filter(width => width <= sourceWidth);
---

<section class="home-hero" aria-labelledby="hero-title">
  <div class="hero-scene">
    <figure class="hero-image" data-photo-id={heroPhoto.id}
      data-photo-kind={heroPhoto.illustrative ? 'illustrative' : 'actual-property'}>
      <Picture src={heroPhoto.src} alt={heroPhoto.alt} widths={widths} sizes="100vw"
        formats={['avif', 'webp']} fallbackFormat="jpg" quality={85}
        loading="eager" fetchpriority="high" />
      {heroPhoto.illustrative && <figcaption>Illustrative interior · not a Topaz apartment</figcaption>}
    </figure>
  </div>

  <div class="hero-content container">
    <div class="hero-copy">
      <span class="hero-eyebrow">{site.tagline}</span>
      <h1 id="hero-title">Your coastal stay in Shanzu starts here</h1>
      <p class="hero-description">One- and two-bedroom apartments in Shanzu, Mombasa, approximately 15 minutes’ walk from the beach.</p>
      <div class="hero-actions">
        <WhatsAppEnquiry variant="primary" label="Enquire on WhatsApp"
          fallbackLabel="Plan your stay" showNote={false} ctaLocation="home_hero" />
        <a class="button button-light" href="/accommodation/">Explore Apartments<span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>

  <div class="hero-features container" aria-label="Discover your Topaz stay">
    {features.map(feature => (
      <article class="feature-card">
        <div class="feature-top">
          <svg class="feature-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={feature.icon} /></svg>
          <span class="feature-number" aria-hidden="true">{feature.number}</span>
        </div>
        <h2>{feature.title}</h2>
        {feature.rate ? (
          <p class="feature-rate">{feature.rate}<span>per night</span></p>
        ) : null}
        <p class="feature-description">{feature.description}</p>

        <a class="feature-link" href={feature.href}>{feature.action}<span aria-hidden="true">↗</span></a>
      </article>
    ))}
  </div>
</section>

<style>
  .home-hero {
    --feature-overlap: var(--space-8);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto var(--feature-overlap) auto;
    isolation: isolate;
  }
  .hero-scene {
    grid-area: 1 / 1 / 3 / -1;
    position: relative;
    overflow: hidden;
    background: var(--color-brand-navy);
  }
  .hero-image,
  .hero-image :global(picture),
  .hero-image :global(img) {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
  }
  .hero-image :global(img) {
    object-fit: cover;
    object-position: 50% 65%;
  }
  .hero-scene::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(10 44 107 / 94%) 0%, rgb(10 44 107 / 88%) 32%, rgb(10 44 107 / 64%) 52%, rgb(10 44 107 / 8%) 78%);
  }
  .hero-scene::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(180deg, rgb(10 44 107 / 82%), transparent 12rem);
  }
  .hero-content {
    grid-area: 1 / 1 / 2 / -1;
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    min-block-size: calc(34rem + var(--site-header-height));
    padding-block: calc(clamp(3rem, 4.5vw, 4rem) + var(--site-header-height)) clamp(3rem, 4.5vw, 4rem);
  }
  .hero-copy {
    max-inline-size: 38rem;
    color: var(--color-white);
  }
  .hero-eyebrow {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    margin-block-end: var(--space-5);
  }
  h1 {
    color: var(--color-white);
    font-size: clamp(2.5rem, 4.5vw, 4.25rem);
    font-weight: var(--weight-semibold);
    line-height: 1.08;
    max-inline-size: 15ch;
    letter-spacing: -0.04em;
  }
  .hero-description {
    max-inline-size: 31rem;
    margin-block: var(--space-5) var(--space-6);
    font-size: var(--text-base);
    line-height: 1.75;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: stretch;
  }
  .hero-actions :global(.button) {
    block-size: 100%;
  }
  .hero-image figcaption {
    position: absolute;
    inset-inline-end: var(--page-gutter);
    inset-block-end: calc(var(--feature-overlap) + var(--space-4));
    z-index: 1;
    max-inline-size: 22rem;
    padding: var(--space-2) var(--space-3);
    background: var(--color-brand-navy);
    color: var(--color-white);
    font-size: var(--text-xs);
  }
  .hero-features {
    grid-area: 2 / 1 / 4 / -1;
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }
  .feature-card {
    min-inline-size: 0;
    display: flex;
    flex-direction: column;
    align-items: start;
    padding: clamp(1.5rem, 2.25vw, 2rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-white);
    box-shadow: 0 12px 36px rgb(10 44 107 / 7%);
  }
  .feature-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    inline-size: 100%;
    margin-block-end: var(--space-4);
  }
  .feature-icon {
    inline-size: 2rem;
    block-size: 2rem;
    color: var(--color-brand-navy);
  }
  .feature-number {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
  h2 {
    font-size: clamp(1.125rem, 1.55vw, 1.375rem);
    line-height: 1.35;
    letter-spacing: var(--tracking-heading);
    text-wrap: pretty;
    margin-block-end: var(--space-3);
  }
  .feature-rate {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    color: var(--color-brand-navy);
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: var(--weight-bold);
    font-variant-numeric: tabular-nums;
    line-height: 1.4;
    margin-block-end: var(--space-3);
  }
  .feature-rate span {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    color: var(--color-muted);
  }
  .feature-description {
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin-block-end: var(--space-3);
  }
  .feature-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    inline-size: 100%;
    min-block-size: var(--touch-target);
    margin-block-start: auto;
    padding-block-start: var(--space-3);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-brand-navy);
    text-decoration: none;
  }
  .feature-link span {
    transition: transform var(--motion-duration) var(--motion-easing);
  }
  .feature-link:hover span {
    transform: translate(2px, -2px);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-image :global(img) {
      animation: photo-reveal 900ms ease-out both;
    }
    .hero-eyebrow,
    h1,
    .hero-description,
    .hero-actions,
    .feature-card {
      animation: content-reveal 650ms ease-out backwards;
    }
    h1 { animation-delay: 60ms; }
    .hero-description { animation-delay: 120ms; }
    .hero-actions { animation-delay: 180ms; }
    .feature-card { animation-delay: 220ms; }
    .feature-card:nth-child(2) { animation-delay: 280ms; }
    .feature-card:nth-child(3) { animation-delay: 340ms; }
  }
  @keyframes content-reveal {
    from { opacity: 0.65; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes photo-reveal {
    from { transform: scale(1.025); }
    to { transform: scale(1); }
  }
  @media (max-width: 64rem) {
    .hero-copy { max-inline-size: 33rem; }
    .hero-scene::after {
      background: linear-gradient(90deg, rgb(10 44 107 / 94%), rgb(10 44 107 / 85%) 45%, rgb(10 44 107 / 24%));
    }
    .hero-features { gap: var(--space-4); }
    .feature-card { padding: var(--space-5); }
  }
  @media (max-width: 48rem) {
    .home-hero { --feature-overlap: 0rem; }
    .hero-content {
      min-block-size: 0;
      padding-block: calc(var(--space-8) + var(--site-header-height)) var(--space-8);
    }
    .hero-copy { max-inline-size: 34rem; }
    h1 { font-size: clamp(2.25rem, 6.5vw, 3.25rem); max-inline-size: 17ch; }
    .hero-scene::after {
      background: linear-gradient(90deg, rgb(10 44 107 / 92%), rgb(10 44 107 / 78%) 70%, rgb(10 44 107 / 68%));
    }
    .hero-image :global(img) { object-position: 50% 66%; }
    .hero-features {
      grid-template-columns: 1fr;
      padding-block-start: var(--space-5);
    }
    .feature-card { padding: var(--space-5); }
    h2 { font-size: 1.25rem; }
    .feature-top { margin-block-end: var(--space-3); }
    .hero-image figcaption {
      inset-inline: var(--page-gutter);
      inset-block-end: var(--space-3);
    }
  }
  @media (max-width: 40rem) {
    .hero-content { padding-block: calc(var(--space-8) + var(--site-header-height)) var(--space-8); }
    .hero-eyebrow { font-size: 0.75rem; }
    .hero-actions { flex-direction: column; }
    .hero-actions > *,
    .hero-actions :global(.button) { inline-size: 100%; }
    .hero-description { line-height: 1.65; }
  }
</style>
