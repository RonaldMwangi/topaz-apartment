---
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import Media from '../components/Media.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Faq from '../components/Faq.astro';
import AccommodationList from '../features/accommodation/AccommodationList.astro';
import FacilityList from '../features/facilities/FacilityList.astro';
import EnquiryForm from '../features/enquiries/EnquiryForm.astro';
import WhatsAppEnquiry from '../features/enquiries/WhatsAppEnquiry.astro';
import EnquirySection from '../features/enquiries/EnquirySection.astro';
import LocationPanel from '../features/location/LocationPanel.astro';
import { photosForCategory } from '../config/media';
import { facilities } from '../config/facilities';
import CoastalExperience from '../features/facilities/CoastalExperience.astro';
import { heroPhoto } from '../config/media';
const mealFacility = facilities.find((facility) => facility.id === 'meals')!;
---

<BaseLayout>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-grid grid-12">
      <div class="hero-copy">
        <span class="eyebrow">
          <span class="location-dot" aria-hidden="true"></span>
          Shanzu, Mombasa · Kenya
        </span>
<h1 id="hero-title">Your coastal stay in Shanzu starts here.</h1>
        <p class="hero-tagline">{site.tagline}</p>
        <p>
          Discover one- and two-bedroom apartments in Shanzu, Mombasa, approximately 15 minutes’ walk from the beach. A swimming pool, ample parking and advance meal and transfer arrangements help shape your stay.
        </p>
<div class="actions">
          <WhatsAppEnquiry variant="primary" label="Enquire on WhatsApp" fallbackLabel="Plan your stay" showNote={false} ctaLocation="home_hero" />
          <a class="button button-outline" href="/accommodation/">Explore Apartments<span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="hero-media">
        <Media label="The Topaz collection" photo={heroPhoto} aspect="portrait" priority />
        <div class="hero-media-bottom">
          <span>Shanzu · Near PrideInn & the Serena Beach area</span>
          <a href="/gallery/">
            A closer look
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
    <div class="hero-footnote">
      <span>THE TOPAZ APARTMENTS EXPERIENCE</span>
      <span>Stay. Unwind. Explore.</span>
      <a href="#apartments" aria-label="Discover the apartments below">
        Scroll to discover
        <span aria-hidden="true">↓</span>
      </a>
    </div>
  </section>
  <section class="container section" id="apartments" aria-label="Our apartments">
    <SectionHeading
      eyebrow="01 / The apartments"
      title="Two ways to stay. One Shanzu setting."
      description="Compare our one- and two-bedroom apartments, see nightly rates and ask our team about your preferred dates."
      href="/accommodation/"
      linkLabel="Explore the collection"
    />
    <AccommodationList />
  </section>
  <section class="facilities-section section" aria-label="Facilities at Topaz">
    <div class="container">
      <SectionHeading
        eyebrow="02 / At your own pace"
        title="The details around your stay."
        description="Time by the pool, space to park and a little help with the arrangements. Discover what’s at Topaz."
        href="/facilities/"
        linkLabel="All facilities & arrangements"
      />
      <FacilityList />
    </div>
  </section>
  <section class="container section meal-feature grid-12" aria-labelledby="meal-heading">
    <div class="meal-media"><Media label={mealFacility.title} photo={photosForCategory('facilities')[0]} variant="outline" /></div>
    <div class="meal-copy">
      <span class="eyebrow">A little forward planning</span>
      <h2 id="meal-heading">
        Make room
        <br />
        for the little things.
      </h2>
      <p class="lead">{mealFacility.description}</p>
      <p>{mealFacility.note}</p>
      <WhatsAppEnquiry
        kind="meals"
        label="Enquire about meals"
        fallbackLabel="Plan meal arrangements"
        variant="text"
      />
    </div>
  </section>
  <section class="stay-enquiry section" aria-labelledby="stay-heading">
    <div class="container grid-12">
      <div class="stay-copy">
        <span class="eyebrow">03 / A conversation, then a stay</span>
        <h2 id="stay-heading">
          A few details.
          <br />
          <em>A personal reply.</em>
        </h2>
        <p>
          Have dates in mind? Start here. Share as much or as little as you like, then continue
          directly with the reservations team on WhatsApp.
        </p>
        <div class="enquiry-steps">
          <span>
            <b>01</b>
            Tell us your plans
          </span>
          <span>
            <b>02</b>
            Prepare your message
          </span>
          <span>
            <b>03</b>
            Confirm the details directly
          </span>
        </div>
        <p class="small muted">
          No online booking. No payment here.
          <br />
          Just the start of your conversation.
        </p>
      </div>
      <div class="stay-form"><EnquiryForm id="home-enquiry" /></div>
    </div>
  </section>
  <section class="container section" aria-label="Our location"><LocationPanel /></section>
  <CoastalExperience />
  <section class="container faq-section section-bottom grid-12" aria-labelledby="faq-heading">
    <div class="faq-copy">
      <span class="eyebrow">Before you arrive</span>
      <h2 id="faq-heading">
        A few things
        <br />
        to know.
      </h2>
      <a class="text-link" href="/contact/">
        Have another question?
        <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="faq-content"><Faq limit={4} /><a class="text-link" href="/contact/#guest-questions">All guest questions<span aria-hidden="true">↗</span></a></div>
  </section>
  <EnquirySection />
</BaseLayout>
<style>
  .hero {
    padding-top: clamp(2rem, 4vw, 4rem);
  }
  .hero-grid {
    align-items: center;
  }
  .hero-copy {
    grid-column: span 6;
    padding-block: 1rem 2rem;
  }
  .hero-copy .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--text-xs);
  }
  .location-dot {
    width: 5px;
    height: 5px;
    background: var(--color-brand-red);
    border-radius: 50%;
  }
  h1 {
    font-size: var(--text-h1);
    line-height: var(--line-height-title);
    letter-spacing: var(--tracking-title);
    max-inline-size: 15ch;
  }
  .hero-tagline {
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--color-brand-navy);
    margin-block: var(--space-5) var(--space-4);
  }
  .hero-tagline::before {
    content: '';
    display: inline-block;
    width: 2rem;
    height: 2px;
    background: var(--color-brand-red);
    vertical-align: middle;
    margin-right: var(--space-3);
  }
  .hero-copy > p:not(.hero-tagline) {
    margin-block: var(--space-4) var(--space-6);
    font-size: var(--text-base);
    color: var(--color-muted);
  }
  .hero-media {
    grid-column: span 6;
    min-width: 0;
  }
  .hero-media :global(.portrait .media-visual) {
    aspect-ratio: 5 / 4;
  }
  .hero-media-bottom {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-top: 1rem;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
  .hero-media-bottom a {
    display: inline-flex;
    gap: 1rem;
    align-items: center;
    min-height: 2.75rem;
    text-decoration: none;
  }
  .hero-footnote {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-block: 1px solid var(--color-border);
    padding-block: 1.25rem;
    margin-top: 2rem;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
  }
  .hero-footnote > span:nth-child(2) {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0;
  }
  .hero-footnote a {
    text-decoration: none;
    display: inline-flex;
    gap: 1.5rem;
    align-items: center;
    min-height: 2rem;
  }
  .facilities-section {
    background: var(--color-surface-alt);
  }
  .meal-feature {
    align-items: center;
  }
  .meal-media {
    grid-column: span 6;
  }
  .meal-copy {
    grid-column: 8 / -1;
  }
  .meal-copy h2 {
    margin-bottom: 1.5rem;
  }
  .meal-copy > p:not(.lead) {
    font-size: var(--text-base);
    color: var(--color-muted);
  }
  .stay-enquiry {
    background: var(--color-surface-tint);
  }
  .stay-copy {
    grid-column: span 5;
    padding-top: 1.5rem;
  }
  .stay-copy h2 {
    margin-bottom: 2rem;
  }
  .stay-copy > p {
    max-width: 25rem;
    color: var(--color-muted);
    font-size: var(--text-base);
  }
  .stay-form {
    grid-column: 7 / -1;
    min-width: 0;
  }
  .enquiry-steps {
    display: grid;
    gap: 1rem;
    margin-block: 2rem;
    font-size: var(--text-sm);
  }
  .enquiry-steps b {
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    color: var(--color-muted);
    margin-right: 1rem;
  }
  .faq-copy {
    grid-column: span 5;
  }
  .faq-copy .text-link {
    margin-top: 2rem;
  }
  .faq-content {
    grid-column: 6 / -1;
  }
  @media (min-width: 80rem) {
    .hero-copy {
      padding-right: 1rem;
    }
  }
  @media (max-width: 64rem) {
    .meal-copy {
      grid-column: 7 / -1;
    }
    .stay-form {
      grid-column: 6 / -1;
    }
  }
  @media (max-width: 48rem) {
    .desktop-break {
      display: none;
    }
    .hero-copy,
    .hero-media,
    .meal-media,
    .meal-copy,
    .stay-copy,
    .stay-form,
    .faq-copy,
    .faq-content {
      grid-column: 1 / -1;
    }
    .hero-copy {
      padding-block: 0 1rem;
    }
    .hero-media :global(.portrait .media-visual) {
      aspect-ratio: 5 / 4;
    }
    .hero-footnote > span:first-child {
      display: none;
    }
    .meal-copy,
    .stay-form,
    .faq-content {
      margin-top: 1.5rem;
    }
  }
</style>
