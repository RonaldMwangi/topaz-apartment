---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import AccommodationList from '../features/accommodation/AccommodationList.astro';
import EnquirySection from '../features/enquiries/EnquirySection.astro';
---

<BaseLayout>
  <div class="container">
    <PageIntro
      title="Your apartment in Shanzu"
      eyebrow="The Topaz collection / Shanzu, Mombasa"
      description="One bedroom or two. Explore the apartment categories, then speak with us about the details of your visit."
    />
    <section class="section-bottom" aria-label="Apartment collection">
      <h2 class="sr-only">Compare apartment types and nightly rates</h2>
      <AccommodationList />
    </section>
    <div class="collection-note">
      <span class="eyebrow">Good to know</span>
      <p>
        Choose one or two bedrooms, then confirm dates, guest capacity, sleeping arrangements,
        availability, applicable charges and booking terms with our reservations team before making plans.
      </p>
      <a class="text-link" href="/facilities/">
        Discover the facilities
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
  <EnquirySection />
</BaseLayout>
<style>
  .collection-note {
    padding: 2rem 0 3.5rem;
    border-top: 1px solid var(--color-border);
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
    gap: 2rem;
    align-items: start;
  }
  .collection-note p {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  @media (max-width: 48rem) {
    .collection-note {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .collection-note .eyebrow {
      margin: 0;
    }
    .collection-note .text-link {
      justify-self: start;
    }
  }
</style>
