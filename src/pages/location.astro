---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import EnquirySection from '../features/enquiries/EnquirySection.astro';
import WhatsAppEnquiry from '../features/enquiries/WhatsAppEnquiry.astro';
import { facilities } from '../config/facilities';
import { site } from '../config/site';
const transfer = facilities.find(facility => facility.id === 'transfers')!;
const mapPreview = `https://www.google.com/maps?q=${site.location.coordinates.latitude},${site.location.coordinates.longitude}&z=15&output=embed`;
---
<BaseLayout>
  <div class="container">
    <section class="location-intro grid-12 section" aria-label="Find Topaz Apartments" data-reveal>
      <div class="location-intro-copy">
        <PageIntro compact title="Find Topaz Apartments in Shanzu" eyebrow="Our location / Mombasa, Kenya" description={site.location.summary} />
        <div class="actions"><a class="button button-primary" href={site.location.mapsUrl} rel="external">Get Directions<span aria-hidden="true">&#8599;</span></a></div>
      </div>
      <div class="map-card">
        <iframe title="Map showing the Topaz Apartments location in Shanzu" src={mapPreview} width="640" height="480" loading="eager" referrerpolicy="no-referrer-when-downgrade"></iframe>
        <a class="map-caption" href={site.location.mapsUrl} rel="external">Open the Topaz Apartments Google Maps place<span aria-hidden="true">&#8599;</span></a>
      </div>
    </section>
    <div class="location-details section-bottom">
      <section class="landmarks" aria-labelledby="landmarks-heading">
        <span class="eyebrow">The surrounding area</span>
        <h2 id="landmarks-heading">Nearby landmarks & the beach</h2>
        <ul>{site.location.nearby.map(landmark => <li>{landmark}</li>)}<li>{site.location.beachWalk}</li></ul>
        <p class="small muted">Landmarks provide location context. Topaz Apartments is not affiliated with PrideInn, Serena Beach Resort or Sunset Paradise.</p>
      </section>
      <section class="arrival" aria-labelledby="arrival-heading">
        <span class="eyebrow">Before you travel</span>
        <h2 id="arrival-heading">Your arrival, thoughtfully planned</h2>
        <p>{transfer.description}</p>
        <p class="small muted">{transfer.note}</p>
        <div class="actions"><WhatsAppEnquiry kind="transfer" label="Plan Your Transfer" fallbackLabel="Prepare a transfer enquiry" variant="text" /><a class="text-link" href="/facilities/#transfer-enquiry">Share journey details<span aria-hidden="true">&#8599;</span></a></div>
      </section>
    </div>
  </div>
  <EnquirySection />
</BaseLayout>
<style>
  .location-intro { align-items: center; }
  .location-intro-copy, .map-card { grid-column: span 6; min-inline-size: 0; }
  .location-intro-copy .actions { margin-block-start: var(--space-6); }
  .map-card { border: 1px solid var(--color-border); background: var(--color-surface-alt); }
  iframe { display: block; inline-size: 100%; block-size: clamp(20rem, 31vw, 28rem); border: 0; }
  .map-caption { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); min-block-size: var(--touch-target); padding: var(--space-4); font-size: var(--text-sm); text-decoration: none; background: var(--color-white); }
  .location-details { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--grid-gap); }
  .location-details > section { padding-block-start: var(--space-6); border-top: 1px solid var(--color-border); }
  h2 { font-size: var(--text-h3); margin-block-end: var(--space-5); }
  ul { padding-inline-start: var(--space-5); margin-block-end: var(--space-5); }
  li + li { margin-block-start: var(--space-2); }
  @media (max-width: 48rem) {
    .location-intro-copy, .map-card { grid-column: 1 / -1; }
    .location-details { grid-template-columns: 1fr; }
    iframe { block-size: 18rem; }
  }
</style>
