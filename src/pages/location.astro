---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import LocationPanel from '../features/location/LocationPanel.astro';
import EnquirySection from '../features/enquiries/EnquirySection.astro';
import WhatsAppEnquiry from '../features/enquiries/WhatsAppEnquiry.astro';
import { facilities } from '../config/facilities';
import { site } from '../config/site';
const transfer = facilities.find((facility) => facility.id === 'transfers')!;
---

<BaseLayout>
  <div class="container">
    <PageIntro
      title="Find Topaz Apartments in Shanzu."
      eyebrow="Our location / Mombasa, Kenya"
      description="Your coastal base in Shanzu, Mombasa, near PrideInn and the Serena Beach area. Follow our Google Maps link for directions."
    />
    <div class="section-bottom"><LocationPanel full /></div>
    <section class="landmarks section-bottom" aria-labelledby="landmarks-heading">
      <span class="eyebrow">The surrounding area</span>
      <h2 id="landmarks-heading">Nearby landmarks & the beach.</h2>
      <ul>
        {site.location.nearby.map(landmark => <li>{landmark}</li>)}
        <li>{site.location.beachWalk}</li>
      </ul>
      <p class="muted">Landmarks are provided for location context. Topaz Apartments is not affiliated with PrideInn or Serena Beach Resort.</p>
      <a class="text-link" href={site.location.mapsUrl} rel="external">Open the Topaz Apartments Google Maps place<span aria-hidden="true">↗</span></a>
    </section>
    <section class="arrival section-bottom" aria-labelledby="arrival-heading">
      <div>
        <span class="eyebrow">Before you travel</span>
        <h2 id="arrival-heading">
          Let’s talk about
          <br />
          getting here.
        </h2>
      </div>
      <div>
        <p class="lead">{transfer.description}</p>
        <p class="muted">{transfer.note}</p>
        <div class="actions">
          <a class="button button-outline" href="/facilities/#transfer-enquiry">
            Share your journey details
            <span aria-hidden="true">↗</span>
          </a>
          <WhatsAppEnquiry
            kind="transfer"
            label="Arrange your transfer"
            fallbackLabel="Prepare a transfer enquiry"
            variant="text"
          />
        </div>
      </div>
    </section>
  </div>
  <EnquirySection />
</BaseLayout>
<style>
  .landmarks { max-width: var(--container-reading); }
  .landmarks h2 { margin-bottom: var(--space-5); }
  .landmarks ul { padding-left: var(--space-5); line-height: 1.8; }
  .arrival {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-border);
  }
  .arrival > div {
    min-width: 0;
  }
  @media (max-width: 48rem) {
    .arrival {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
