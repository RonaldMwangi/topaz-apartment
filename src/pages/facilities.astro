---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Media from '../components/Media.astro';
import WhatsAppEnquiry from '../features/enquiries/WhatsAppEnquiry.astro';
import EnquiryForm from '../features/enquiries/EnquiryForm.astro';
import EnquirySection from '../features/enquiries/EnquirySection.astro';
import { photoForPlacement } from '../config/media';
import { facilities } from '../config/facilities';
import CoastalExperience from '../features/facilities/CoastalExperience.astro';
const pool = facilities.find(facility => facility.id === 'pool')!;
const transfer = facilities.find((facility) => facility.id === 'transfers')!;
---

<BaseLayout>
  <div class="container">
    <PageIntro editorial
      title="Facilities for your Shanzu stay"
      eyebrow="At Topaz / Facilities & arrangements"
      description="Time by the pool, meals planned in advance, thoughtful transfers and memorable yacht experiences."
    />
    <section class="pool-feature experience-row grid-12" id="pool" aria-labelledby="pool-heading">
      <div class="pool-copy">
        <span class="eyebrow">At your own pace / Swimming pool</span>
        <h2 id="pool-heading">{pool.shortTitle}</h2>
        <p class="lead">{pool.description}</p>
        <p class="muted">{pool.note}</p>
        <WhatsAppEnquiry label="Plan Your Stay" variant="text" ctaLocation="pool" />
      </div>
      <div class="pool-media"><Media photo={photoForPlacement('facilities-pool')} label="Swimming pool" aspect="landscape" /></div>
    </section>
    <section class="meal-feature experience-row grid-12" id="meals" aria-labelledby="meals-heading">
      <div class="meal-copy">
        <span class="eyebrow">Cafeteria & meal arrangements</span>
        <h2 id="meals-heading">Good food, thoughtfully arranged</h2>
        <p class="lead">Make more time for your stay while we organise your meal arrangements in advance. Share your meal and kitchen preferences with our team before arrival.</p>
        <p class="small muted">Our team confirms availability, applicable charges and arrangements.</p>
        <WhatsAppEnquiry kind="meals" label="Arrange Your Meals" variant="text" ctaLocation="facility_meals" />
      </div>
      <div class="meal-media"><Media photo={photoForPlacement('facilities-meals')} label="Meal arrangements" aspect="landscape" /></div>
    </section>
  </div>
  <section class="transfer-section section" id="transfers" aria-labelledby="transfer-heading">
    <div class="container grid-12">
      <div class="transfer-copy">
        <span class="eyebrow">Arrive with a plan</span>
        <h2 id="transfer-heading">
          The journey
          <br />
          matters, too
        </h2>
        <p class="lead">{transfer.description}</p>
        <p>{transfer.note}</p>
      </div>
      <div class="transfer-form"><EnquiryForm mode="transfer" id="transfer-enquiry" /></div>
    </div>
  </section>
  <CoastalExperience />
  <EnquirySection />
</BaseLayout>
<style>
  .experience-row { align-items: center; padding-block-end: var(--space-8); }
  .pool-copy, .pool-media, .meal-copy, .meal-media { grid-column: span 6; }
  .pool-copy, .meal-copy { max-inline-size: 34rem; }
  .experience-row h2 { margin-block-end: var(--space-5); }
  .meal-feature { padding-block-start: var(--space-8); border-top: 1px solid var(--color-border); }
  .meal-feature { margin-block-end: var(--space-5); }
  @media (max-width: 48rem) {
    .pool-copy, .pool-media, .meal-copy, .meal-media { grid-column: 1 / -1; }
    .experience-row { row-gap: var(--space-5); }
  }
  .transfer-section {
    background: var(--color-surface-alt);
  }
  .transfer-copy {
    grid-column: span 5;
    padding-top: 1rem;
  }
  h2 {
    margin-bottom: 2rem;
  }
  .transfer-copy > p:not(.lead) {
    color: var(--color-muted);
    font-size: var(--text-base);
    max-width: 25rem;
  }
  .transfer-form {
    grid-column: 7 / -1;
    min-width: 0;
  }
@media (max-width: 64rem) {
    .transfer-form {
      grid-column: 6 / -1;
    }
  }
  @media (max-width: 48rem) {
    .transfer-copy,
    .transfer-form {
      grid-column: 1 / -1;
    }
    .transfer-form {
      margin-top: 1.5rem;
    }
}
</style>
