---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import EnquiryForm from '../features/enquiries/EnquiryForm.astro';
import WhatsAppEnquiry from '../features/enquiries/WhatsAppEnquiry.astro';
import Faq from '../components/Faq.astro';
import { site } from '../config/site';
---
<BaseLayout>
  <div class="container">
    <section class="contact-grid grid-12 section" aria-label="Contact and enquiry details" data-reveal>
      <div class="contact-heading">
        <PageIntro compact title="Every stay starts with a hello" eyebrow="Contact / Talk to Topaz"
          description="Share your dates or tell us what you have in mind. Our team will help plan the details of your stay." />
        <div class="actions">
          <WhatsAppEnquiry label="Enquire on WhatsApp" showNote={false} />
          <a class="text-link" href="#enquiry">Share your dates <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <div class="contact-form"><EnquiryForm /></div>
      <div class="contact-details">
        <div class="contact-detail"><h2>Find us</h2><p>{site.location.summary}</p>
          <a class="text-link" href="/location/">Location & arrival <span aria-hidden="true">↗</span></a></div>
        <div class="contact-detail"><h2>WhatsApp Business</h2><p>{site.whatsappNumber}</p></div>
        <div class="contact-detail"><h2>Planning a transfer?</h2>
          <p>Let us organise your arrival. Share your pickup, destination and travel details.</p>
          <a class="text-link" href="/facilities/#transfer-enquiry">Prepare transfer details <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>
    <section class="contact-faq section-bottom" id="guest-questions" aria-labelledby="contact-faq-title">
      <span class="eyebrow">Good to know</span><h2 id="contact-faq-title">Before we talk</h2><Faq />
    </section>
  </div>
</BaseLayout>
<style>
  .contact-grid { align-items: start; row-gap: var(--space-6); grid-template-rows: auto 1fr; }
  .contact-heading { grid-column: span 5; grid-row: 1; }
  .contact-heading .actions { margin-block-start: var(--space-6); }
  .contact-form { grid-column: 7 / -1; grid-row: 1 / 3; min-inline-size: 0; }
  .contact-details { grid-column: span 5; grid-row: 2; }
  .contact-detail { border-top: 1px solid var(--color-border); padding-block-start: var(--space-5); }
  .contact-detail + .contact-detail { margin-block-start: var(--space-5); }
  .contact-detail h2 { font-size: var(--text-sm); text-transform: uppercase; letter-spacing: var(--tracking-label); margin-block-end: var(--space-3); }
  .contact-detail p { font-size: var(--text-sm); color: var(--color-muted); }
  .contact-faq { max-inline-size: 54rem; margin-inline: auto; }
  .contact-faq h2 { margin-block-end: var(--space-6); }
  @media (max-width: 64rem) { .contact-form { grid-column: 6 / -1; } }
  @media (max-width: 48rem) {
    .contact-grid { grid-template-rows: auto; }
    .contact-heading, .contact-form, .contact-details { grid-column: 1 / -1; }
    .contact-form { grid-row: 2; }
    .contact-details { grid-row: 3; }
  }
</style>
