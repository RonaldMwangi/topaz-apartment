---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import EnquiryForm from '../features/enquiries/EnquiryForm.astro';
import WhatsAppEnquiry from '../features/enquiries/WhatsAppEnquiry.astro';
import Faq from '../components/Faq.astro';
import { site, locationLabel } from '../config/site';
import { normalizeWhatsAppNumber } from '../utils/whatsapp';
const connected = !!normalizeWhatsAppNumber(site.whatsappNumber);
---

<BaseLayout>
  <div class="container">
    <PageIntro
      title="Every stay starts with a hello."
      eyebrow="Contact / Let’s make a plan"
      description="Dates in mind, a question to ask, or a few arrangements to discuss. We’d be happy to hear from you."
    />
    <section class="contact-grid grid-12 section-bottom" aria-label="Contact and enquiry details">
      <div class="contact-copy">
        <span class="eyebrow">Talk to Topaz</span>
        <h2>
          A conversation,
          <br />
          with your stay in mind.
        </h2>
        <div class="contact-detail">
          <h3>Find us</h3>
          <p>{locationLabel}</p>
          {site.location.exactAddress && <p>{site.location.exactAddress}</p>}
          <a class="text-link" href="/location/">
            Location & arrival
            <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="contact-detail">
          <h3>WhatsApp Business</h3>
          {connected ? (
            <>
              <p>{site.whatsappNumber}</p>
              <WhatsAppEnquiry variant="text" />
            </>
          ) : (
            <div class="contact-status">
              <span class="status-label">Development preview</span>
              <p>
                The official WhatsApp Business number is awaiting confirmation. You can prepare and preview an
                enquiry here; messages cannot be sent yet.
              </p>
            </div>
          )}
        </div>
        <div class="contact-detail">
          <h3>Planning a transfer?</h3>
          <p>Share your pickup and destination with the property to discuss arrangements.</p>
          <a class="text-link" href="/facilities/#transfer-enquiry">
            Prepare transfer details
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <div class="contact-form"><EnquiryForm /></div>
    </section>
    <section class="contact-faq section-bottom" id="guest-questions" aria-labelledby="contact-faq-title">
      <span class="eyebrow">Good to know</span>
      <h2 id="contact-faq-title">Before we talk.</h2>
      <Faq />
    </section>
  </div>
</BaseLayout>
<style>
  .contact-copy {
    grid-column: span 5;
  }
  .contact-copy > h2 {
    font-size: var(--text-h3);
    margin-bottom: 2.5rem;
  }
  .contact-detail {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    max-width: 26rem;
  }
  .contact-detail h3 {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .contact-detail p {
    font-size: var(--text-base);
    color: var(--color-muted);
  }
  .contact-form {
    grid-column: 7 / -1;
    min-width: 0;
  }
  .contact-status {
    padding: 1.25rem;
    border-left: 2px solid var(--color-brand-red);
    background: var(--color-surface-alt);
  }
  .status-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  .contact-faq {
    max-width: 54rem;
    margin-inline: auto;
  }
  .contact-faq h2 {
    margin-bottom: 2rem;
  }
  @media (max-width: 64rem) {
    .contact-form {
      grid-column: 6 / -1;
    }
  }
  @media (max-width: 48rem) {
    .contact-copy,
    .contact-form {
      grid-column: 1 / -1;
    }
    .contact-form {
      margin-top: 2rem;
    }
  }
</style>
