---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Gallery from '../features/gallery/Gallery.astro';
import EnquirySection from '../features/enquiries/EnquirySection.astro';
import { galleryCategories } from '../config/media';
---

<BaseLayout>
  <div class="container">
    <PageIntro editorial
      title="A closer look at Topaz"
      eyebrow="The gallery / Spaces & details"
      description="Explore the apartments, interior details and coastal inspiration for your stay at Topaz. Illustrative photographs are labelled throughout."
    />
    <nav class="gallery-navigation" aria-label="Gallery categories">
      <ul>
        {galleryCategories.map(({ id, label }) => (
          <li>
            <a href={`#gallery-${id}`}>
              {label}
              <span aria-hidden="true">↓</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="section-bottom"><Gallery /></div>
  </div>
  <EnquirySection />
</BaseLayout>
<style>
  .gallery-navigation {
    margin-bottom: var(--space-6);
  }
  ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    padding: 0;
    margin: 0;
  }
  a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    gap: 1rem;
    font-size: var(--text-sm);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
  }
  a:hover {
    border-color: var(--color-action);
  }
</style>
