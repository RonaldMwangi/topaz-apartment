---
import { site } from '../config/site';

interface Props {
  presentation?: 'navigation' | 'footer' | 'full';
}
const { presentation = 'navigation' } = Astro.props;
// The horizontal variation is a pixel-preserving crop of the approved brand
// guide. Full presentation retains the supplied original artwork.
const logo = { src: '/brand/topaz-logo-original.jpeg', width: 568, height: 568 };
---

{presentation === 'full' ? (
  <a class="brand-asset" href="/" aria-label={`${site.name} home`}>
    <img src={logo.src} width={logo.width} height={logo.height} alt={`${site.name} — ${site.tagline}`} loading="lazy" decoding="async" />
  </a>
) : (
  <a class:list={['brand-navigation', { 'brand-footer': presentation === 'footer' }]} href="/" aria-label={`${site.name} home`}>
    <img src="/brand/topaz-logo-horizontal.png" width="136" height="52"
      alt={`${site.name} — ${site.tagline}`} loading={presentation === 'footer' ? 'lazy' : 'eager'} decoding="async" />
  </a>
)}

<style>
  .brand-navigation {
    display: inline-flex;
    flex-direction: column;
    align-items: start;
    flex-shrink: 0;
    text-decoration: none;
    color: var(--color-brand-navy);
    padding: var(--space-4);
  }
  .brand-navigation img {
    inline-size: auto;
    block-size: 3rem;
    max-inline-size: 100%;
    object-fit: contain;
  }
  @media (max-width: 48rem) {
    .brand-navigation img {
      block-size: 2.5rem;
    }
  }
  .brand-footer { padding: var(--space-1); }
  .brand-footer img { block-size: 3rem; }
  .brand-asset {
    /* At a 240px image width the logo's T is approximately 24px tall.
         This 32px envelope exceeds that reference, in addition to original margins. */
    --logo-width: 15rem;
    --logo-clear-space: 2rem;
    display: inline-flex;
    max-inline-size: 100%;
    padding: var(--logo-clear-space);
    background: var(--color-logo-surface);
    border-radius: var(--radius);
  }
  .brand-asset img {
    inline-size: var(--logo-width);
    max-inline-size: 100%;
    block-size: auto;
  }
</style>
