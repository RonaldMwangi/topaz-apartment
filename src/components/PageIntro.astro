---
interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  compact?: boolean;
  editorial?: boolean;
}
const { title, description, eyebrow, compact = false, editorial = false } = Astro.props;
---

<header class:list={['page-intro', { compact, editorial }]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  <p class="description">{description}</p>
</header>

<style>
  .page-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    column-gap: var(--grid-gap);
    align-items: end;
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }
  .eyebrow, h1 { grid-column: 1; }
  h1 {
    max-inline-size: 16ch;
  }
  .description {
    color: var(--color-muted);
    font-size: var(--text-lg);
    grid-column: 2;
    grid-row: 1 / 3;
    margin: 0;
    max-inline-size: 39rem;
  }
  .editorial { align-items: center; padding-block: var(--space-6) var(--space-8); }
  .editorial h1 { font-size: var(--text-display); max-inline-size: 19ch; }
  .editorial .description { max-inline-size: 31rem; }
  .compact { display: block; padding: 0; }
  .compact .description { margin-block-start: var(--space-5); }
  @media (max-width: 48rem) {
    .page-intro { display: block; }
    .description { margin-block-start: var(--space-5); }
  }
</style>
