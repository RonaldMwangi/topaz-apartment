---
import BrandIdentity from './BrandIdentity.astro';
import { locationLabel, navigation, site } from '../config/site';
import WhatsAppEnquiry from '../features/enquiries/WhatsAppEnquiry.astro';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-intro">
      <BrandIdentity presentation="full" />
      <p class="footer-tagline">{site.tagline}</p>
      <span class="footer-location">{locationLabel}</span>
    </div>
    <div>
      <h2>Explore</h2>
      <nav aria-label="Footer">
        <ul>
          {navigation.map(({ href, label }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <div>
      <h2>Your stay</h2>
      <ul>
        <li><a href="/accommodation/one-bedroom/">One-bedroom apartment</a></li>
        <li><a href="/accommodation/two-bedroom/">Two-bedroom apartment</a></li>
        <li><a href="/facilities/#meals">Meal arrangements</a></li>
        <li><a href="/facilities/#transfers">Transport & transfers</a></li>
      </ul>
    </div>
    <div class="footer-contact">
      <h2>Let’s talk</h2>
      <p>
        Dates, details or a question.
        <br />
        Start a conversation with us.
      </p>
      <WhatsAppEnquiry variant="light" fallbackLabel="Prepare your enquiry" ctaLocation="footer" />
      <!-- Official social profiles can be added here when supplied. -->
    </div>
  </div>
  <div class="container footer-bottom">
    <span>{`© ${new Date().getFullYear()} ${site.name}. All rights reserved.`}</span>
    <span>Shanzu, with care.</span>
  </div>
</footer>
<style>
  .site-footer {
    background: var(--color-dark);
    color: var(--color-on-action);
    padding-block: clamp(3rem, 6vw, 5rem) 1.5rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: minmax(19rem, 1.2fr) 0.65fr 1fr 1.1fr;
    gap: var(--space-6);
    padding-bottom: 4rem;
  }
  .footer-tagline {
    margin-top: var(--space-5);
    font-size: var(--text-base);
    color: var(--color-white);
  }
  h2 {
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }
  p,
  li,
  .footer-location {
    font-size: var(--text-sm);
  }
  .footer-location {
    color: var(--color-on-dark-muted);
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--touch-target);
    padding-block: 0.5rem;
    text-decoration: none;
  }
  li a:hover {
    text-decoration: underline;
  }
  .footer-bottom {
    border-top: 1px solid rgb(255 255 255 / 20%);
    padding-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--text-xs);
    opacity: 0.75;
  }
  @media (max-width: 75rem) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 40rem) {
    .footer-grid {
      gap: 2rem;
    }
    .footer-intro,
    .footer-contact {
      grid-column: 1 / -1;
    }
  }
</style>
