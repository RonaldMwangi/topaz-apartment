---
import BrandIdentity from './BrandIdentity.astro';
import { navigation, site } from '../config/site';
import WhatsAppEnquiry from '../features/enquiries/WhatsAppEnquiry.astro';
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-intro">
      <BrandIdentity presentation="footer" />
      <div class="footer-brand-copy">
        <p class="footer-tagline">{site.tagline}</p>
        <p class="footer-description">Discover one- and two-bedroom accommodation in Shanzu, Mombasa, around 15 minutes’ walk from the beach. Enjoy the pool, with meals, transfers and Mtwapa Creek yacht experiences arranged through our team.</p>
        <p class="footer-location">Next to Sunset Paradise · Serena Beach area</p>
      </div>
    </div>
    <nav class="footer-navigation" aria-label="Footer">
      <h2>Explore</h2>
      <ul>{navigation.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
        <li><a href="/accommodation/one-bedroom/">One-bedroom apartment</a></li>
        <li><a href="/accommodation/two-bedroom/">Two-bedroom apartment</a></li>
      </ul>
    </nav>
    <div class="footer-contact">
      <h2>Talk to Topaz</h2>
      <a class="footer-phone" href={`tel:${site.whatsappNumber}`}>{site.whatsappNumber}</a>
      <WhatsAppEnquiry variant="light" fallbackLabel="Prepare your enquiry" showNote={false} ctaLocation="footer" />
    </div>
  </div>
  <div class="container footer-bottom"><span>© {new Date().getFullYear()} {site.name}. All rights reserved.</span><a href={site.location.mapsUrl} rel="external">Shanzu, Mombasa, Kenya <span aria-hidden="true">↗</span></a></div>
</footer>
<style>
  .site-footer { background: var(--color-dark); color: var(--color-white); padding-block: var(--space-8) var(--space-4); }
  .footer-grid { display: grid; grid-template-columns: 1.5fr 1.5fr 1fr; gap: var(--space-8); align-items: start; padding-block-end: var(--space-5); }
  .footer-intro { display: grid; grid-template-columns: 8.5rem minmax(0, 1fr); align-items: start; gap: var(--space-4); }
  .footer-tagline { font-family: var(--font-heading); font-size: var(--text-sm); font-weight: var(--weight-medium); line-height: 1.6; margin-block-end: var(--space-3); max-inline-size: none; }
  .footer-description { font-family: var(--font-body); font-size: var(--text-sm); font-weight: var(--weight-regular); line-height: 1.6; color: var(--color-on-dark-muted); max-inline-size: 38ch; margin-block-end: var(--space-3); }
  .footer-location { font-size: var(--text-xs); color: var(--color-on-dark-muted); margin: 0; }
  h2 { font-family: var(--font-heading); font-size: var(--text-sm); color: inherit; font-weight: var(--weight-semibold); text-transform: uppercase; letter-spacing: var(--tracking-label); margin-block-end: var(--space-4); }
  ul { list-style: none; padding: 0; margin: 0; }
  .footer-navigation ul { display: grid; grid-template-columns: 1fr 1fr; column-gap: var(--space-5); row-gap: var(--space-1); }
  li a, .footer-phone { display: inline-flex; align-items: center; min-block-size: var(--touch-target); font-family: var(--font-body); font-size: var(--text-sm); line-height: 1.65; color: var(--color-on-dark-muted); text-decoration: none; }
  li a:hover, .footer-phone:hover { text-decoration: underline; }
  .footer-contact { min-inline-size: 0; }
  .footer-phone { font-weight: var(--weight-medium); color: var(--color-white); margin-block-end: var(--space-4); }
  .footer-contact :global(.button) { font-size: var(--text-xs); gap: var(--space-3); }
  .footer-bottom { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-3); border-top: 1px solid rgb(255 255 255 / 20%); padding-block-start: var(--space-4); color: var(--color-on-dark-muted); font-size: var(--text-xs); }
  .footer-bottom a { display: inline-flex; align-items: center; gap: var(--space-3); min-block-size: var(--touch-target); text-decoration: none; }
  @media (max-width: 75rem) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: var(--space-5) var(--space-6); }
    .footer-intro { grid-column: 1; gap: var(--space-3) var(--space-4); }
    .footer-brand-copy { display: contents; }
    .footer-tagline { grid-column: 2; align-self: center; margin: 0; }
    .footer-description, .footer-location { grid-column: 1 / -1; margin: 0; }
    .footer-navigation { grid-column: 2; grid-row: 1 / 3; }
    .footer-contact { grid-column: 1; grid-row: 2; }
  }
  @media (max-width: 40rem) {
    .footer-grid { grid-template-columns: 1fr; gap: var(--space-6); }
    .footer-intro, .footer-navigation, .footer-contact { grid-column: 1; grid-row: auto; }
    .footer-tagline { max-inline-size: none; }
    .footer-contact { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-5); }
    .footer-contact h2 { flex: 1; margin: 0; }
    .footer-phone { margin: 0; }
    .footer-contact :global(.enquiry-action), .footer-contact :global(.button) { inline-size: 100%; }
    .footer-bottom { gap: 0; }
  }
</style>
