---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
}
const { eyebrow, title, description, href, linkLabel } = Astro.props;
---

<div class="section-heading">
  <div>
    <span class="eyebrow">{eyebrow}</span>
    <h2>{title}</h2>
  </div>
  <div class="section-aside">
    {description && <p class="muted">{description}</p>}
    {href && (
      <a class="text-link" href={href}>
        {linkLabel}
        <span aria-hidden="true">↗</span>
      </a>
    )}
  </div>
</div>
